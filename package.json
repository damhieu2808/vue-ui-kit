{
  "name": "vue-ui-kit",
  "version": "0.1.0",
  "description": "A lightweight Vue 3 component library built with TypeScript and Vite",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/vue-ui-kit.umd.cjs",
  "module": "./dist/vue-ui-kit.js",
  "exports": {
    ".": {
      "import": "./dist/vue-ui-kit.js",
      "require": "./dist/vue-ui-kit.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vue-tsc && vite build",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.ts"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/vue3": "^8.0.0",
    "@storybook/vue3-vite": "^8.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
